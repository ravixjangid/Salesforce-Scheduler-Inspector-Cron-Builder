{
  "manifest_version": 3,
  "name": "Salesforce Scheduler Inspector & Cron Builder",
  "version": "1.0.0",
  "description": "Monitor Salesforce scheduled jobs, review org-aware run status, and build Quartz cron expressions",
  "permissions": [
    "storage",
    "cookies",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://*.salesforce.com/*",
    "https://*.salesforce-setup.com/*",
    "https://*.force.com/*"
  ],
  "action": {
    "default_title": "Salesforce Scheduler Inspector & Cron Builder",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.salesforce.com/*",
        "https://*.salesforce-setup.com/*",
        "https://*.force.com/*"
      ],
      "js": [
        "utils/salesforce-host-support.js",
        "salesforce-launcher.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "popup-embed.js",
        "popup.css",
        "popup.js",
        "cron-maker.html",
        "cron-maker.css",
        "cron-maker.js",
        "utils/salesforce-host-support.js",
        "utils/salesforce-api.js",
        "icons/icon16.png",
        "icons/icon48.png",
        "icons/icon128.png"
      ],
      "matches": [
        "https://*.salesforce.com/*",
        "https://*.salesforce-setup.com/*",
        "https://*.force.com/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
